{
  "require-dev": {
    "johnpbloch/wordpress-core-installer": "*",
    "johnpbloch/wordpress": "*",
    "php-stubs/wp-cli-stubs": "*"
  },
  "config": {
    "allow-plugins": {
      "johnpbloch/wordpress-core-installer": true
    }
  },
  "extra": {
    "wordpress-install-dir": "/tmp/wordpress"
  },
  "scripts": {
    "post-install-cmd": [
      "rm -rf ~/.zed/autocomplete/wordpress",
      "mv /tmp/wordpress ~/.zed/autocomplete/wordpress",
      "rm -rf vendor/php-stubs/wordpress-stubs"
    ]
  }
}
